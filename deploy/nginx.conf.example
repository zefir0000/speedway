# Put map in the http context, outside the server block.
map $http_upgrade $speedway_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name speedway.example.com;
    ssl_certificate /etc/letsencrypt/live/speedway.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/speedway.example.com/privkey.pem;
    client_max_body_size 200k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $speedway_connection_upgrade;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
