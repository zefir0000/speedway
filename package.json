{
    "name": "speedway",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "db:generate": "drizzle-kit generate",
        "start": "node --env-file-if-exists=.env server.mjs",
        "test:online": "node --test tests/online-finish.mjs",
        "db:migrate": "node --env-file-if-exists=.env scripts/migrate-mariadb.mjs",
        "test:server": "node --test tests/server-*.mjs",
        "test:integration": "node --test tests/services.integration.mjs",
        "release": "node scripts/release.mjs"
    },
    "dependencies": {
        "drizzle-orm": "0.45.2",
        "mariadb": "3.5.4",
        "redis": "5.11.0",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "drizzle-kit": "0.31.10"
    },
    "engines": {
        "node": ">=22.13.0"
    }
}