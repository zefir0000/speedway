# Node 22.13+, MySQL 8.0+, Redis 6.2+. Copy to .env before startup.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://speedway.example.com
# Generate once with: openssl rand -hex 32
SESSION_SECRET=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=speedway
MYSQL_PASSWORD=
MYSQL_DATABASE=speedway
MYSQL_POOL_SIZE=5
# Use a dedicated Redis instance or dedicated namespace with noeviction + AOF.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=speedway:
MAX_ROOMS=100
MAX_CONNECTIONS=500
